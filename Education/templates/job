    {% if job %}
                    {% for x in job %}
                    <div class="col-md-12">
                        <div class="job_box border-bottom d-flex justify-content-between p-2">
                            <!-- content here  -->
                            <div style="width: 30rem;">
                                <h4 class="fw-bold">{{x.job_title}}</h4>
                                <p>{{x.company}}</p>


                            </div>
                            <!-- location here  -->
                            <div>
                                <div class="d-flex justify-content-center align-items-center">
                                    <i class="fa-solid fa-location-dot pe-2"></i>
                                    <p>

                                        {% if state %}
                                        {% for y in state %}
                                        {% if y.id|stringformat:"s" == x.state %}
                                        {{y.State_name}}
                                        {% endif %}
                                        {% endfor %}
                                        {% endif %}


                                    </p>
                                </div>
                                <p class="text-danger"> Last Date: {{x.end_date}}</p>
                                <!-- <a href="" class="text-primary"> {% if x.job_category == '1' %} Teaching {% else %} Non-Teaching{% endif %}</a> -->
                            </div>
                            <!-- apply button here  -->
                            <div>
                                <button class="btn btn-danger btn-sm">Apply Job</button>
                                <h4 class="mb-2" style="font-size: 20px;"></h4>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                    {% endif %}